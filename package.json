{
  "name": "@ustaxcourt/ustc-pay-gov-test-server",
  "version": "0.4.0",
  "description": "USTC Pay.gov test server",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ustaxcourt/ustc-pay-gov-test-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npx tsc",
    "dev": "npx tsc && APP_ENV=local concurrently \"npx tsc --watch\" \"node --watch ./dist/server.js\"",
    "copy-files": "aws s3 cp src/static s3://dev-ustc-pay-gov-test-server --recursive",
    "test": "jest ./src",
    "test:coverage": "jest --coverage ./src",
    "start": "node .",
    "test:integration": "APP_ENV=local jest --verbose --bail ./test/integration",
    "test:integration:coverage": "APP_ENV=local jest --config jest.config.ts --coverage --testPathPatterns=integration",
    "test:integration:deployed": "DOTENV_CONFIG_PATH=.env.prod APP_ENV=dev jest --bail ./test/integration",
    "ci:publish": "changeset publish"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bin": {
    "start-pay-gov-test-server": "bin/start-pay-gov-test-server.sh"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.test.js",
    "!dist/useCaseHelpers/testAppContext.js",
    "src/static",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24.20.0 <25.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.0",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/aws-lambda": "^8.10.162",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.26",
    "@types/luxon": "^3.7.5",
    "cheerio": "^1.2.0",
    "concurrently": "10.0.6",
    "esbuild": "^0.28.1",
    "jest": "^30.5.2",
    "soap": "^1.14.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "babel-plugin-istanbul": "^8.0.2",
    "test-exclude": "^8.0.0",
    "glob": "^13.0.6"
  }
}
