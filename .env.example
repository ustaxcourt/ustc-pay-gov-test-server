# Local development configuration. Copy to .env (`cp .env.example .env`).
# Deployed environments are configured via Terraform — see terraform/.

# URL the Express server binds to and advertises.
BASE_URL=http://localhost:3366

# Deployed environments only — NOT needed for local development.
# Local runs (APP_ENV=local) skip authentication entirely, so this value is
# ignored. Deployed environments get it from AWS Secrets Manager via
# Terraform; see terraform/secrets.tf.
# Bearer token for the `Authentication: Bearer ...` header on protected routes.
# (Header name is `Authentication` — non-standard but case-insensitive; see src/lambdas/authenticateRequest.ts.)
ACCESS_TOKEN=asdf123

# Port for the local Express server.
PORT=3366

# Deployment topology. One of: local, dev, test. See src/config/appEnv.ts.
APP_ENV=local
